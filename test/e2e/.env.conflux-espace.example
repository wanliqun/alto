CONFLUX_ESPACE_NETWORK=testnet
CONFLUX_ESPACE_RPC_URL=https://<your-conflux-espace-rpc>
CONFLUX_ESPACE_ALTO_RPC_URL=
CONFLUX_ESPACE_SEND_TRANSACTION_RPC_URL=
CONFLUX_ESPACE_BUNDLER_PRIVATE_KEY=
CONFLUX_ESPACE_EXECUTOR_PRIVATE_KEYS=
CONFLUX_ESPACE_OWNER_PRIVATE_KEY=
CONFLUX_ESPACE_ENTRYPOINT_VERSIONS=0.8
CONFLUX_ESPACE_SEND_BUNDLE_NOW=false
# Empty defaults to true on testnet and false on mainnet.
CONFLUX_ESPACE_DEPLOY_CONTRACTS=
CONFLUX_ESPACE_PORT=4337
CONFLUX_ESPACE_BLOCK_TIME_MS=1000
CONFLUX_ESPACE_LOG_LEVEL=debug
CONFLUX_ESPACE_SAFE_MODE=false
CONFLUX_ESPACE_BALANCE_OVERRIDE=false
CONFLUX_ESPACE_CODE_OVERRIDE_SUPPORT=false
